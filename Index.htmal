<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Alpa Lines">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#0B7A75">
<title>Alpa Lines</title><link rel="manifest" href="manifest.json"><link rel="apple-touch-icon" href="apple-touch-icon.png"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Alpa Lines"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="theme-color" content="#0F2A5C"><link rel="icon" href="icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* Concept: one-column phone app. Sticky top bar, fixed bottom tab bar, cards on a cool grey ground.
   Teal marks actions and trust, amber marks money and examples. Manrope for everything (has Latin and Cyrillic). */
:root{
  --bg:#F4F6F8; --surface:#FFFFFF; --line:#E1E6EB; --line-strong:#C9D1D9;
  --fg:#0E1B2B; --muted:#52606F;
  --btn:#0B7A75; --btn-ink:#FFFFFF; --accent:#0B7A75; --accent-soft:#E3F2F1; --accent-ink:#075A56;
  --amber-soft:#FDE9C8; --amber-ink:#7A4300; --blue-soft:#E1ECFA; --blue-ink:#1F4C8F;
  --rose-soft:#FBE5E8; --rose-ink:#8F2A3A; --danger:#B3261E; --bubble-in:#FFFFFF;
  color-scheme:light;
  --font:'Manrope',system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0E1620; --surface:#16212E; --line:#263545; --line-strong:#34475A;
    --fg:#E8EEF4; --muted:#9AA9B8;
    --btn:#0B7A75; --btn-ink:#FFFFFF; --accent:#5FC4BE; --accent-soft:#14322F; --accent-ink:#8FE0DA;
    --amber-soft:#3A2A10; --amber-ink:#F2C27A; --blue-soft:#16283F; --blue-ink:#9CC3F5;
    --rose-soft:#3A1B21; --rose-ink:#F2A3B0; --danger:#FF8A80; --bubble-in:#1E2C3B;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0E1620; --surface:#16212E; --line:#263545; --line-strong:#34475A;
  --fg:#E8EEF4; --muted:#9AA9B8;
  --btn:#0B7A75; --btn-ink:#FFFFFF; --accent:#5FC4BE; --accent-soft:#14322F; --accent-ink:#8FE0DA;
  --amber-soft:#3A2A10; --amber-ink:#F2C27A; --blue-soft:#16283F; --blue-ink:#9CC3F5;
  --rose-soft:#3A1B21; --rose-ink:#F2A3B0; --danger:#FF8A80; --bubble-in:#1E2C3B;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:500 15px/1.45 var(--font);-webkit-text-size-adjust:100%}
button,input,select,textarea{font-family:var(--font)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
h1,h2,h3,p{margin:0}
.in{max-width:560px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.bar{position:sticky;top:0;padding-top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}
.bar .in{display:flex;align-items:center;gap:8px;min-height:56px}
.brand{display:flex;align-items:center;gap:9px;font-weight:800;font-size:19px;letter-spacing:-.4px;flex:1;min-width:0}
.logo{width:30px;height:30px;border-radius:9px;background:var(--btn);display:grid;place-items:center;flex:none}
.langs{display:flex}
.lg{min-width:42px;min-height:44px;border:0;background:transparent;color:var(--muted);font-weight:700;font-size:13px;cursor:pointer;border-radius:10px}
.lg.on{color:var(--accent)}
.icon{width:44px;height:44px;border:0;background:transparent;color:var(--fg);display:grid;place-items:center;cursor:pointer;margin-left:-10px;flex:none}
.ttl{font-size:17px;font-weight:800;letter-spacing:-.2px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wrap{max-width:560px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:14px calc(96px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:12px}
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.tabs .in{display:flex;justify-content:space-around}
.tab{flex:1;min-height:60px;border:0;background:transparent;color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;font-weight:600;cursor:pointer}
.tab.on{color:var(--accent);font-weight:800}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px;min-width:0}
.btn{min-height:44px;border:0;border-radius:999px;padding:0 18px;background:var(--btn);color:var(--btn-ink);font-weight:700;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}
.btn.ghost{background:transparent;color:var(--accent);border:1px solid var(--accent)}
.btn.soft{background:var(--accent-soft);color:var(--accent-ink)}
.btn.danger{background:transparent;color:var(--danger);border:1px solid var(--line-strong)}
.btn.block{width:100%}
.btn[disabled]{opacity:.55;cursor:default}
.chip{display:inline-flex;align-items:center;min-height:26px;padding:0 10px;border-radius:999px;font-size:12px;font-weight:700;background:var(--bg);color:var(--muted);white-space:nowrap}
.chip.teal{background:var(--accent-soft);color:var(--accent-ink)}
.chip.amber{background:var(--amber-soft);color:var(--amber-ink)}
.av{display:inline-grid;place-items:center;border-radius:50%;font-weight:800;flex:none;letter-spacing:.2px}
.av0{background:var(--accent-soft);color:var(--accent-ink)}.av1{background:var(--amber-soft);color:var(--amber-ink)}
.av2{background:var(--blue-soft);color:var(--blue-ink)}.av3{background:var(--rose-soft);color:var(--rose-ink)}
.av4{background:var(--line);color:var(--fg)}
.who{display:flex;align-items:center;gap:10px;min-width:0;background:none;border:0;padding:0;color:inherit;text-align:left;cursor:pointer;font:inherit;flex:1}
.who .nm{font-weight:800;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.who .sub{font-size:12px;color:var(--muted);overflow-wrap:anywhere}
.who>span:last-child{min-width:0;display:flex;flex-direction:column}
.head{display:flex;align-items:center;gap:10px}
.route{display:flex;align-items:center;gap:8px;font-weight:800;font-size:17px;letter-spacing:-.3px;flex-wrap:wrap}
.route svg{color:var(--muted);flex:none}
.top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.price{font-weight:800;font-size:18px;color:var(--accent);white-space:nowrap;font-variant-numeric:tabular-nums}
.price small{display:block;font-size:11px;font-weight:600;color:var(--muted);text-align:right}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.muted{color:var(--muted)}
.txt{white-space:pre-wrap;overflow-wrap:anywhere}
.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:space-between}
.seg{display:flex;background:var(--line);border-radius:12px;padding:4px;gap:4px}
.seg button{flex:1;min-height:40px;border:0;border-radius:9px;background:transparent;color:var(--muted);font-weight:700;font-size:13px;cursor:pointer}
.seg button.on{background:var(--btn);color:var(--btn-ink)}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.field{display:flex;flex-direction:column;gap:6px;min-width:0}
.field label{font-size:13px;font-weight:700;color:var(--muted)}
.field input,.field select,.field textarea{width:100%;min-height:48px;border:1px solid var(--line-strong);border-radius:12px;padding:0 12px;background:var(--surface);color:var(--fg);font-size:16px;font-weight:500}
.field textarea{padding:12px;min-height:110px;resize:vertical;line-height:1.45}
.sel{min-height:44px!important;font-size:15px!important}
.err{color:var(--danger);font-weight:700;font-size:13px}
.note{font-size:12px;color:var(--muted);text-align:center}
.empty{text-align:center;padding:28px 12px;color:var(--muted);display:flex;flex-direction:column;gap:12px;align-items:center}
.empty p{max-width:30ch}
.banner{background:var(--accent-soft);color:var(--accent-ink);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px;align-items:flex-start;font-weight:600}
.teaser{display:flex;align-items:center;gap:10px;width:100%;min-height:56px;text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:6px 14px 6px 10px;color:var(--muted);font-size:15px;cursor:pointer}
.act{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
.act button{min-height:44px;min-width:44px;border:0;background:transparent;color:var(--fg);display:inline-flex;align-items:center;gap:6px;font-weight:700;font-size:13px;padding:0 10px;cursor:pointer;border-radius:10px}
.act button.liked{color:var(--danger)}
.sp{flex:1}
.msgs{display:flex;flex-direction:column;gap:8px}
.b{max-width:80%;padding:9px 12px;border-radius:16px;overflow-wrap:anywhere;white-space:pre-wrap}
.b.in-{align-self:flex-start;background:var(--bubble-in);border:1px solid var(--line);border-bottom-left-radius:4px}
.b.out{align-self:flex-end;background:var(--btn);color:var(--btn-ink);border-bottom-right-radius:4px}
.b time{display:block;font-size:11px;opacity:.75;margin-top:2px}
.inputbar{position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--surface);border-top:1px solid var(--line);padding-block:8px;padding-bottom:calc(8px + env(safe-area-inset-bottom,0px))}
.inputbar form{display:flex;gap:8px;align-items:center}
.inputbar input{flex:1;min-width:0;min-height:46px;border:1px solid var(--line-strong);border-radius:23px;padding:0 16px;background:var(--bg);color:var(--fg);font-size:16px}
.send{width:46px;height:46px;border:0;border-radius:50%;background:var(--btn);color:var(--btn-ink);display:grid;place-items:center;cursor:pointer;flex:none}
h2.sec{font-size:13px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-top:6px}
.chatrow{display:flex;align-items:center;gap:12px;width:100%;min-height:64px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:10px 12px;text-align:left;cursor:pointer;color:inherit;font:inherit}
.chatrow .mid{flex:1;min-width:0;display:flex;flex-direction:column}
.chatrow .nm{font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chatrow .ls{font-size:13px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sk{height:96px;border-radius:14px;background:var(--line);opacity:.6}
@media (prefers-reduced-motion:no-preference){.card,.chatrow{transition:border-color .15s}}

.vb{vertical-align:-2px;margin-left:4px;flex:none}
.stories{display:flex;gap:14px;overflow-x:auto;padding:2px 2px 8px;margin:0 -4px;scrollbar-width:none}
.stories::-webkit-scrollbar{display:none}
.st{border:0;background:none;padding:0;width:64px;flex:none;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;color:var(--fg);font:inherit}
.ring{display:grid;place-items:center;width:60px;height:60px;border-radius:50%;border:2px solid var(--line-strong)}
.ring.on{border:3px solid var(--accent)}
.stn{font-size:11px;font-weight:600;max-width:64px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fab{width:52px;height:52px;border:0;border-radius:50%;background:var(--btn);color:var(--btn-ink);display:grid;place-items:center;cursor:pointer;align-self:center;flex:none;margin:0 4px}
.scrim{position:fixed;inset:0;background:rgba(8,14,22,.55);z-index:20}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;background:var(--surface);border-radius:18px 18px 0 0;padding:18px max(16px,env(safe-area-inset-left,0px)) calc(18px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:10px;max-width:560px;margin:0 auto}
.sheet h2{font-size:18px;font-weight:800;margin-bottom:2px}
.btn.plain{background:transparent;color:var(--muted)}
.stats{display:flex;gap:8px}
.stats div{flex:1;min-width:0;background:var(--bg);border-radius:12px;padding:8px 10px;display:flex;flex-direction:column}
.stats b{font-size:16px;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stats span{font-size:12px;color:var(--muted);font-weight:600}
.proCard{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:60px;background:var(--accent-soft);color:var(--accent-ink);border:1px solid var(--accent);border-radius:14px;padding:10px 14px;text-align:left;cursor:pointer;font:inherit}
.proCard>span{display:flex;flex-direction:column;min-width:0}
.proCard b{font-weight:800}.proCard .muted{color:var(--accent-ink);font-size:13px}
.proHead{background:#0E1B2B;color:#fff;border-radius:16px;padding:18px;display:flex;flex-direction:column;gap:8px}
.proHead h2{font-size:24px;font-weight:800;letter-spacing:-.4px;line-height:1.2}
.proHead p{color:#C9D1D9;font-size:14px}
.proTag{display:flex;align-items:center;gap:8px;color:#F2A33A;font-size:13px;letter-spacing:.6px}
.card h3{font-size:16px;font-weight:800}
.ck{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.ck li{display:flex;gap:8px;font-size:14px;align-items:flex-start}
.ck svg{flex:none;margin-top:1px;color:var(--accent)}
.card.pro{border:2px solid var(--accent);position:relative;margin-top:6px}
.pop{position:absolute;top:-12px;right:14px;background:#F2A33A;color:#2B1800;font-size:11px;font-weight:800;padding:4px 10px;border-radius:999px}
.stars{display:flex;gap:4px}.stars button{font-size:30px;line-height:1;background:none;border:0;color:#F2A33A;cursor:pointer;padding:6px}
</style>
</head>
