almaty:{uz:`Olmaota`,ru:`Алматы`,en:`Almaty`},astana:{uz:`Ostona`,ru:`Астана`,en:`Astana`},
shymkent:{uz:`Shymkent`,ru:`Шымкент`,en:`Shymkent`},bishkek:{uz:`Bishkek`,ru:`Бишкек`,en:`Bishkek`},
osh:{uz:`O'sh`,ru:`Ош`,en:`Osh`},dushanbe:{uz:`Dushanbe`,ru:`Душанбе`,en:`Dushanbe`},
khujand:{uz:`Xo'jand`,ru:`Худжанд`,en:`Khujand`},ashgabat:{uz:`Ashgabat`,ru:`Ашхабад`,en:`Ashgabat`},
moscow:{uz:`Moskva`,ru:`Москва`,en:`Moscow`},istanbul:{uz:`Istanbul`,ru:`Стамбул`,en:`Istanbul`},
urumqi:{uz:`Urumchi`,ru:`Урумчи`,en:`Urumqi`}};
var TRUCKS=['reefer','tent','container','flatbed','other'];
var TYPES=['carrier','shipper','manufacturer'];



Object.assign(T.uz,{orders_tab:`Buyurtmalar`,ord_open:`Ochiq`,ord_mine:`Mening`,new_order:`Buyurtma berish`,no_orders:`Hozircha buyurtma yo'q.`,no_my_orders:`Sizda buyurtma yo'q.`,ord_price:`Taklif qilinadigan narx`,currency:`Valyuta`,cur_s:`so'm`,order_title:`Buyurtma`,st_open:`Ochiq`,st_accepted:`Qabul qilindi`,st_loading:`Yuklanmoqda`,st_transit:`Yo'lda`,st_delivered:`Yetkazildi`,st_cancelled:`Bekor qilindi`,offers:`Takliflar`,no_offers:`Hali taklif yo'q.`,send_offer:`Taklif yuborish`,offer_price:`Sizning narxingiz`,offer_sent:`Taklifingiz yuborildi`,choose:`Tanlash`,cancel_order:`Buyurtmani bekor qilish`,ord_customer:`Buyurtmachi`,ord_carrier:`Tashuvchi`,next_loading:`Yuklashni boshladim`,next_transit:`Yo'lga chiqdim`,next_delivered:`Yetkazdim`,rate_title:`Hamkorni baholang`,rated:`Baho berildi`,open_btn:`Ochish`});
