var CITIES={
tashkent:{uz:`Toshkent`,ru:`Ташкент`,en:`Tashkent`},samarkand:{uz:`Samarqand`,ru:`Самарканд`,en:`Samarkand`},
bukhara:{uz:`Buxoro`,ru:`Бухара`,en:`Bukhara`},fergana:{uz:`Farg'ona`,ru:`Фергана`,en:`Fergana`},
andijan:{uz:`Andijon`,ru:`Андижан`,en:`Andijan`},namangan:{uz:`Namangan`,ru:`Наманган`,en:`Namangan`},
